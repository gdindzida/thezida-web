hreehalfs = 1.5F;</span></div><div style="scrollbar-color: rgba(111, 195, 223, 0.6) rgb(0, 0, 0); text-align: left;"><span style="scrollbar-color: rgba(111, 195, 223, 0.6) rgb(0, 0, 0); color: light-dark(rgb(192, 192, 192), rgb(0, 254, 248));">x2 = number * 0.5F;</span></div><div style="scrollbar-color: rgba(111, 195, 223, 0.6) rgb(0, 0, 0); text-align: left;"><span style="scrollbar-color: rgba(111, 195, 223, 0.6) rgb(0, 0, 0); color: light-dark(rgb(192, 192, 192), rgb(0, 254, 248));">y  = number;</span></div><div style="scrollbar-color: rgba(111, 195, 223, 0.6) rgb(0, 0, 0); text-align: left;"><span style="scrollbar-color: rgba(111, 195, 223, 0.6) rgb(0, 0, 0); color: light-dark(rgb(192, 192, 192), rgb(0, 254, 248));">i  = * ( long * ) &amp;y;</span></div><div style="scrollbar-color: rgba(111, 195, 223, 0.6) rgb(0, 0, 0); text-align: left;"><span style="scrollbar-color: rgba(111, 195, 223, 0.6) rgb(0, 0, 0); color: light-dark(rgb(192, 192, 192), rgb(0, 254, 248));">i  = 0x5f3759df - ( i &gt;&gt; 1 );</span></div><div style="scrollbar-color: rgba(111, 195, 223, 0.6) rgb(0, 0, 0); text-align: left;"><span style="scrollbar-color: rgba(111, 195, 223, 0.6) rgb(0, 0, 0); color: light-dark(rgb(192, 192, 192), rgb(0, 254, 248));">y  = * ( float * ) &amp;i;</span></div><div style="scrollbar-color: rgba(111, 195, 223, 0.6) rgb(0, 0, 0); text-align: left;"><span style="scrollbar-color: rgba(111, 195, 223, 0.6) rgb(0, 0, 0); color: light-dark(rgb(192, 192, 192), rgb(0, 254, 248));">y  = y * ( threehalfs - ( x2 * y * y ) );</span></div><div style="scrollbar-color: rgba(111, 195, 223, 0.6) rgb(0, 0, 0); text-align: left;"><span style="scrollbar-color: rgba(111, 195, 223, 0.6) rgb(0, 0, 0); color: light-dark(rgb(192, 192, 192), rgb(0, 254, 248));">return y;</span></div></div></div></div></foreignObject><text x="521" y="199" fill="#000000" font-family="Helvetica" font-size="12px" text-anchor="middle" style="fill: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));"><tspan x="521" y="199">long i;</tspan><tspan x="521" y="213">float x2, y;</tspan><tspan x="521" y="227">const float threehalfs = 1.5F;</tspan><tspan x="521" y="241">x2 = number * 0.5F;</tspan><tspan x="521" y="255">y = number;</tspan><tspan x="521" y="269">i = * ( long * ) &amp;y;</tspan><tspan x="521" y="283">i = 0x5f3759df - ( i &gt;&gt; 1 );</tspan><tspan x="521" y="297">y = * ( float * ) &amp;i;</tspan><tspan x="521" y="311">y = y * ( threehalfs - ( x2 * y * y ) );</tspan><tspan x="521" y="325">return y;</tspan></text></switch></g></g></g></g></g></g><switch><g requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility"/><a transform="translate(0,-5)" xlink:href="https://www.drawio.com/doc/faq/svg-export-text-problems" target="_blank"><text text-anchor="middle" font-size="10px" x="50%" y="100%">Text is not SVG - cannot display</text></a></switch></svg>