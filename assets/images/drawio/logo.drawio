                <mxCell id="MHgUrGrL8G3NQ0UegtPd-66" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;div style=&quot;scrollbar-color: rgba(111, 195, 223, 0.6) rgb(0, 0, 0); text-align: left;&quot;&gt;&lt;span style=&quot;scrollbar-color: rgba(111, 195, 223, 0.6) rgb(0, 0, 0); color: light-dark(rgb(192, 192, 192), rgb(0, 254, 248));&quot;&gt;long i;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;scrollbar-color: rgba(111, 195, 223, 0.6) rgb(0, 0, 0); text-align: left;&quot;&gt;&lt;span style=&quot;scrollbar-color: rgba(111, 195, 223, 0.6) rgb(0, 0, 0); color: light-dark(rgb(192, 192, 192), rgb(0, 254, 248));&quot;&gt;float x2, y;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;scrollbar-color: rgba(111, 195, 223, 0.6) rgb(0, 0, 0); text-align: left;&quot;&gt;&lt;span style=&quot;scrollbar-color: rgba(111, 195, 223, 0.6) rgb(0, 0, 0); color: light-dark(rgb(192, 192, 192), rgb(0, 254, 248));&quot;&gt;const float threehalfs = 1.5F;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;scrollbar-color: rgba(111, 195, 223, 0.6) rgb(0, 0, 0); text-align: left;&quot;&gt;&lt;span style=&quot;scrollbar-color: rgba(111, 195, 223, 0.6) rgb(0, 0, 0); color: light-dark(rgb(192, 192, 192), rgb(0, 254, 248));&quot;&gt;x2 = number * 0.5F;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;scrollbar-color: rgba(111, 195, 223, 0.6) rgb(0, 0, 0); text-align: left;&quot;&gt;&lt;span style=&quot;scrollbar-color: rgba(111, 195, 223, 0.6) rgb(0, 0, 0); color: light-dark(rgb(192, 192, 192), rgb(0, 254, 248));&quot;&gt;y&amp;nbsp; = number;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;scrollbar-color: rgba(111, 195, 223, 0.6) rgb(0, 0, 0); text-align: left;&quot;&gt;&lt;span style=&quot;scrollbar-color: rgba(111, 195, 223, 0.6) rgb(0, 0, 0); color: light-dark(rgb(192, 192, 192), rgb(0, 254, 248));&quot;&gt;i&amp;nbsp; = * ( long * ) &amp;amp;y;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;scrollbar-color: rgba(111, 195, 223, 0.6) rgb(0, 0, 0); text-align: left;&quot;&gt;&lt;span style=&quot;scrollbar-color: rgba(111, 195, 223, 0.6) rgb(0, 0, 0); color: light-dark(rgb(192, 192, 192), rgb(0, 254, 248));&quot;&gt;i&amp;nbsp; = 0x5f3759df - ( i &amp;gt;&amp;gt; 1 );&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;scrollbar-color: rgba(111, 195, 223, 0.6) rgb(0, 0, 0); text-align: left;&quot;&gt;&lt;span style=&quot;scrollbar-color: rgba(111, 195, 223, 0.6) rgb(0, 0, 0); color: light-dark(rgb(192, 192, 192), rgb(0, 254, 248));&quot;&gt;y&amp;nbsp; = * ( float * ) &amp;amp;i;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;scrollbar-color: rgba(111, 195, 223, 0.6) rgb(0, 0, 0); text-align: left;&quot;&gt;&lt;span style=&quot;scrollbar-color: rgba(111, 195, 223, 0.6) rgb(0, 0, 0); color: light-dark(rgb(192, 192, 192), rgb(0, 254, 248));&quot;&gt;y&amp;nbsp; = y * ( threehalfs - ( x2 * y * y ) );&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;scrollbar-color: rgba(111, 195, 223, 0.6) rgb(0, 0, 0); text-align: left;&quot;&gt;&lt;span style=&quot;scrollbar-color: rgba(111, 195, 223, 0.6) rgb(0, 0, 0); color: light-dark(rgb(192, 192, 192), rgb(0, 254, 248));&quot;&gt;return y;&lt;/span&gt;&lt;/div&gt;" vertex="1">
